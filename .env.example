# Copy this file to .env and fill in the values.
# .env is git-ignored and must NEVER be committed.
#
# The JWT key must be a strong random string, at least 32 characters.
# Generate one with:  pwsh -c "[System.Convert]::ToBase64String((1..48|%{[byte](Get-Random -Max 256)}))"

Jwt__Key=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
