@page "/scoring"
@attribute [Authorize]
@rendermode InteractiveServer
@using Armageddon.Abstractions.Models
@using Armageddon.Web.Services
@inject IArmageddonApiClient ApiClient

<PageTitle>Scoring</PageTitle>

<h2>Scoring</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row g-4">
    <!-- Objectives column -->
    <div class="col-md-6">
        <h4>Objectives</h4>
        <div class="row g-2 mb-3 align-items-end">
            <div class="col-sm-4">
                <label class="form-label mb-1">Name</label>
                <input class="form-control" placeholder="Objective name" @bind="newObjectiveName" @bind:event="oninput" @onkeydown="HandleObjectiveKeyDown" />
            </div>
            <div class="col-sm-3">
                <label class="form-label mb-1">Type</label>
                <select class="form-select" @bind="newObjectiveType">
                    <option value="@ObjectiveType.Recurring">Recurring</option>
                    <option value="@ObjectiveType.OneTime">One-time</option>
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label mb-1">Max Usage</label>
                <input type="number" class="form-control" placeholder="Unlimited" @bind="newObjectiveMaxUsage" />
            </div>
            <div class="col-sm-2">
                <button class="btn btn-primary w-100" @onclick="AddObjective" disabled="@string.IsNullOrWhiteSpace(newObjectiveName)">Add</button>
            </div>
        </div>
        @if (isLoading)
        {
            <p><em>Loading…</em></p>
        }
        else if (!objectives.Any())
        {
            <p>No objectives yet.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var obj in objectives)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>
                            <strong>@obj.Name</strong>
                            <span class="badge @(obj.Type == ObjectiveType.OneTime ? "bg-warning text-dark" : "bg-info text-dark") ms-2">
                                @(obj.Type == ObjectiveType.OneTime ? "One-time" : "Recurring")
                            </span>
                            @if (obj.MaxUsage is not null && obj.MaxUsage != -1)
                            {
                                <span class="badge bg-secondary ms-1">Max: @obj.MaxUsage</span>
                            }
                        </span>
                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveObjective(obj.Id)">Remove</button>
                    </li>
                }
            </ul>
        }
    </div>

    <!-- Rounds column -->
    <div class="col-md-4">
        <h4>Rounds</h4>
        <div class="mb-3">
            <button class="btn btn-primary" @onclick="AddNextRound">Add Round @(rounds.Count + 1)</button>
        </div>
        @if (!rounds.Any())
        {
            <p>No rounds yet.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var round in rounds)
                {
                    <li class="list-group-item">Round @round.Number</li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private List<Objective> objectives = [];
    private List<Round> rounds = [];
    private string newObjectiveName = string.Empty;
    private ObjectiveType newObjectiveType = ObjectiveType.Recurring;
    private int? newObjectiveMaxUsage;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            objectives = (await ApiClient.GetObjectivesAsync()).ToList();
            rounds = (await ApiClient.GetRoundsAsync()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddObjective()
    {
        if (string.IsNullOrWhiteSpace(newObjectiveName)) return;
        errorMessage = null;
        try
        {
            await ApiClient.AddObjectiveAsync(newObjectiveName.Trim(), newObjectiveType, newObjectiveMaxUsage);
            newObjectiveName = string.Empty;
            newObjectiveType = ObjectiveType.Recurring;
            newObjectiveMaxUsage = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add objective: {ex.Message}";
        }
    }

    private async Task RemoveObjective(int id)
    {
        errorMessage = null;
        try
        {
            await ApiClient.RemoveObjectiveAsync(id);
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove objective: {ex.Message}";
        }
    }

    private async Task AddNextRound()
    {
        errorMessage = null;
        try
        {
            await ApiClient.AddRoundAsync(rounds.Count + 1);
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add round: {ex.Message}";
        }
    }

    private async Task HandleObjectiveKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddObjective();
    }
}
