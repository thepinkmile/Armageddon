@page "/teams"
@attribute [Authorize]
@rendermode InteractiveServer
@using Armageddon.Abstractions.Models
@using Armageddon.Web.Services
@inject IArmageddonApiClient ApiClient

<PageTitle>Teams</PageTitle>

<h2>Teams</h2>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="input-group">
            <input class="form-control" placeholder="Team name" @bind="newTeamName" @bind:event="oninput" @onkeydown="HandleKeyDown" />
            <button class="btn btn-primary" @onclick="AddTeam" disabled="@string.IsNullOrWhiteSpace(newTeamName)">
                Add Team
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Loading…</em></p>
}
else if (!teams.Any())
{
    <p>No teams yet. Add one above.</p>
}
else
{
    <ul class="list-group" style="max-width:400px">
        @foreach (var team in teams)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>@team.Name</span>
                <button class="btn btn-sm btn-danger" @onclick="() => RemoveTeam(team.Id)">Remove</button>
            </li>
        }
    </ul>
}

@code {
    private List<Team> teams = [];
    private string newTeamName = string.Empty;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTeams();
    }

    private async Task LoadTeams()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            teams = (await ApiClient.GetTeamsAsync()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load teams: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddTeam()
    {
        if (string.IsNullOrWhiteSpace(newTeamName)) return;
        errorMessage = null;
        try
        {
            await ApiClient.AddTeamAsync(newTeamName.Trim());
            newTeamName = string.Empty;
            await LoadTeams();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to add team: {ex.Message}";
        }
    }

    private async Task RemoveTeam(int id)
    {
        errorMessage = null;
        try
        {
            await ApiClient.RemoveTeamAsync(id);
            await LoadTeams();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to remove team: {ex.Message}";
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTeam();
    }
}
